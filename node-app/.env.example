# Adapter: mock (default, no SAP) | rfc (requires SAP NWRFC SDK + node-rfc)
CTS_ADAPTER=mock

# HTTP
PORT=43127
HOST=0.0.0.0

# RFC connection (only when CTS_ADAPTER=rfc)
SAP_ASHOST=sap.example.com
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWD=
SAP_LANG=EN
# Optional: SAP_DEST=MME  (uses sapnwrfc.ini instead of direct params)
