# Adapter: mock | rfc | http
#   mock — sample data (no SAP)
#   rfc  — node-rfc + NWRFC SDK → CTS_API_READ_CHANGE_REQUEST
#   http — HTTPS → ABAP ICF ZCL_CTS_EXTRACT_ICF → CTS_API_READ_CHANGE_REQUEST
CTS_ADAPTER=mock

# HTTP server (Node UI)
PORT=43127
HOST=0.0.0.0

# --- RFC (CTS_ADAPTER=rfc) ---
SAP_ASHOST=sap.example.com
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWD=
SAP_LANG=EN
# Optional: SAP_DEST=MME  (sapnwrfc.ini)

# --- HTTP / ICF (CTS_ADAPTER=http) ---
# Real SAP:
# CTS_HTTP_URL=https://sap.example.com:44300/sap/bc/zcts_extract?sap-client=100
# Local demo of the ICF contract (same Node process):
CTS_HTTP_URL=http://127.0.0.1:43127/sap/bc/zcts_extract
CTS_HTTP_USER=
CTS_HTTP_PASSWD=
# Or: CTS_HTTP_TOKEN=...
